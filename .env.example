# --- Required for live AI (at least one provider) ---
# Preferred: Groq (current project default model openai/gpt-oss-20b)
GROQ_API_KEY=***REMOVED_GROQ_API_KEY***
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_SIMPLE=openai/gpt-oss-20b
GROQ_MODEL_COMPLEX=openai/gpt-oss-20b
GROQ_MODEL_STRUCTURED=openai/gpt-oss-20b

# Optional fallback if Groq is unset
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# auto | groq | xai
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Production persistence (optional) ---
# If unset, the backend uses local SQLite at DATA_DIR/learnwise.db
